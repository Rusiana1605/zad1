@model IEnumerable<zad1.ViewModels.Song.SongIndexViewModel>

@{
    ViewData["Title"] = "Songs";
}

<h1>Songs</h1>

<p>
    <a asp-action="Create">Create New Song</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseYear)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ArtistName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var song in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => song.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => song.ReleaseYear)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => song.ArtistName)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@song.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@song.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@song.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>