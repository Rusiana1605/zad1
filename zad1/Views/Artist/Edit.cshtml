@model zad1.ViewModels.Artist.ArtistEditViewModel

@{
    ViewData["Title"] = "Edit Artist";
}

<h1>Edit Artist</h1>

<h4>Artsist</h4>
<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Genre" class="control-label"></label>
                <input asp-for="Genre" class="form-control" />
                <span asp-validation-for="Genre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FoundedYear" class="control-label"></label>
                <input asp-for="FoundedYear" class="form-control" />
                <span asp-validation-for="FoundedYear" class="text-danger"></span>
            </div>

            <br />

            <div class="form-group">
                <input type="submit"
                       value="Save"
                       class="btn btn-primary" />
            </div>

        </form>

    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

