@model IEnumerable<zad1.ViewModels.Artist.ArtistIndexViewModel>

@{
    ViewData["Title"] = "Artists";
}

<h1>Artists</h1>

<p>
    <a asp-action="Create">Create New Artist</a>
</p>

<form asp-controller="Artist" asp-action ="Index" method="get">
    <div class="row mb-4">
        <div class="col-md-4">
            <label class="form-label">Artist Name</label>
            <input type="text"
                name="search"
                value="@ViewBag.Search"
                class="form-control"
                placeholder="Search by name..."/>
        </div>       
        <div class"col-md-3">
            <label class="form-label">Artist genre</label>
            <input type="text"
                name="genre"
                value="@ViewBag.Genre"
                class="form-control"
                placeholder="Search by genre..."/>
          
        </div>
    </div>
    <div class="col-md-3">
        <label class="form-label">Sort By</label>
        <select name="sortOrder" class=":form-control">
            <option value="name"
                    selected="@(ViewBag.SortedOrder == "name")">Name A-Z</option>"
            <option value="genre"
                    selected="@(ViewBag.SortedOrder == "genre")">Genre A-Z</option>
            </select>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
    
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FoundedYear)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var artist in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => artist.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => artist.Genre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => artist.FoundedYear)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@artist.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@artist.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@artist.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>