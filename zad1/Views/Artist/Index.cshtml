@model IEnumerable<zad1.ViewModels.Artist.ArtistIndexViewModel>

@{
    ViewData["Title"] = "Artists";
}

<h1>Artists</h1>

<p>
    <a asp-action="Create">Create New Artist</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FoundedYear)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var artist in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => artist.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => artist.Genre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => artist.FoundedYear)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@artist.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@artist.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@artist.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>