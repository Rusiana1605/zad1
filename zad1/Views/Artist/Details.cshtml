@model zad1.ViewModels.Artist.ArtistDetailsViewModel

@{
    ViewData["Title"] = "Artist Details";
}

<h1>Artist Details</h1>

<div>
    <h4>@Model.Name</h4>

    <hr />

    <dl class="row">
        <dt class="col-sm-3">Genre</dt>
        <dd class="col-sm-9">@Model.Genre</dd>

        <dt class="col-sm-3">Founded Year</dt>
        <dd class="col-sm-9">@Model.FoundedYear</dd>
    </dl>

</div>

<a asp-action="Edit"
   asp-route-id="@Model.Id"
   class="btn btn-warning">
    Edit
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>
