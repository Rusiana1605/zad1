@model IEnumerable<zad1.ViewModels.Playlist.PlaylistIndexViewModel>

@{
    ViewData["Title"] = "Playlists";
}

<h1>Playlists</h1>

<p>
    <a asp-action="Create">Create New Playlist</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SongsCount)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var patient in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => patient.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => patient.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => patient.SongsCount)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@patient.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@patient.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@patient.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>

